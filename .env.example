APP_NAME="Mrs. Beauty"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://mrs-beauty.test

# Deutsch ist die Produktsprache. Der Agent darf ausschliesslich auf Deutsch
# antworten (docs/fachlogik/agent.md, Schritt 7, Pruefung "Fremdsprache").
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=UTC

# Alle fachlichen Datums- und Zeitentscheidungen (Wochentagsmaske, Zeitfenster,
# Slot-Grenzen) werden in dieser Zone ausgewertet, nicht in APP_TIMEZONE.
APP_BUSINESS_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hostnamen sind Laradock-Servicenamen, aufgeloest im Docker-Netz. Aus einem
# Terminal auf dem Host heraus sind sie nicht erreichbar -- artisan, composer
# und npm laufen im workspace-Container.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mrs_beauty
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# **Anhaenge laufen NICHT ueber FILESYSTEM_DISK**, sondern ueber diese eigene
# Variable (config/mrs.php, WP-18) -- Nachrichtenanhaenge, Logos,
# Referenzmaterial und die erzeugten Anzeigenbilder.
#
# **In Produktion ist `s3` Pflicht.** Container werden ersetzt, und mit ihnen
# verschwaende jede verschluesselte Datei. Eine Plattform, die einen Bucket
# verbindet, setzt `FILESYSTEM_DISK` -- von dieser Variable weiss sie nichts,
# also muss sie von Hand gesetzt werden. Am 22.09.2026 stand sie deshalb auf
# `local`, und jede Anzeigengrafik war nach dem Schreiben unerreichbar:
# erzeugt im Worker-Container, gesucht im Web-Container.
ATTACHMENTS_DISK=local

# Queues laufen lokal ueber Redis, nicht ueber die Datenbank: WP-33 braucht
# getrennte Queues (realtime, default, sync, maintenance) mit eigenen
# Worker-Profilen.
#
# **In Produktion steht hier `cloud`** -- die verwaltete Warteschlange von
# Laravel Cloud. Die vier Arbeiter werden dort in der Oberflaeche
# eingerichtet, nicht hier; die Kommandos stehen in docs/betrieb.md.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# phpredis ist in workspace und php-fpm installiert.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Laradocks Redis ist passwortgeschuetzt (REDIS_PASSWORD in laradock/.env).
REDIS_PASSWORD=secret_redis

# Diese Redis-Instanz wird mit allen anderen Projekten in Laradock geteilt.
# Ohne eigenes Praefix und eigene Datenbanknummer laufen Cache- und
# Queue-Schluessel ineinander -- ein Job dieses Projekts landet dann im
# Worker eines anderen.
REDIS_PREFIX=mrs_beauty_
REDIS_DB=3
REDIS_CACHE_DB=4
# Leer, weil der Cache bereits eine eigene Redis-Datenbank hat. Sonst stuende
# das Praefix zweimal im Schluessel.
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mrs-beauty.test"
MAIL_FROM_NAME="${APP_NAME}"

# Eingang des E-Mail-Kanals (WP-20b). Der Eingangsdienst weist sich mit dem
# Token aus; die Adresse einer Praxis ist <kennung>@MAIL_INBOUND_DOMAIN.
MAIL_INBOUND_DOMAIN=inbound.mrs-beauty.de
MAIL_INBOUND_TOKEN=

# Der Bucket hinter ATTACHMENTS_DISK=s3. Auf einer Plattform mit verbundenem
# Bucket kommen diese Werte von dort; lokal bleiben sie leer.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Meta (WP-00, WP-19..WP-22, WP-26..WP-28, WP-31, WP-32) -------------------
# Die API-Version wird hier festgenagelt, nie aus dem SDK uebernommen.
# docs/integrationen/meta.md, Abschnitt "API-Version".
META_API_VERSION=v21.0
# Nur setzen, wer gegen eine eigene Gegenstelle prueft.
META_GRAPH_URL=https://graph.facebook.com
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Werbekonten (WP-26). Die Konfigurations-ID entscheidet, ob Meta ein
# Systembenutzer- oder ein Nutzertoken ausstellt -- ohne sie laeuft die
# Strecke ueber Bereiche und traegt nur Entwicklung und App-Review-Demo.
META_LOGIN_URL=https://www.facebook.com/v21.0/dialog/oauth
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI="${APP_URL}/oauth/meta/callback"

# Conversions API (WP-32b). Ohne Zugang wird nichts gesendet.
META_CAPI_TOKEN=

# Bilderzeugung fuer Anzeigenvorschlaege (WP-31, Entscheidung C10).
# Ohne Schluessel entstehen Texte, aber keine Bilder.
KIE_API_KEY=

# Bildmodell. gpt-image-2-text-to-image setzt deutsche Schrift zuverlaessiger
# als google/nano-banana (Fundstelle: kie.ai/gpt-image-2).
KIE_MODEL=gpt-image-2-text-to-image
KIE_RESOLUTION=2K

# Das Hochformat 4:5 (WP-31b). GPT Image 2 nimmt 4:5 in 2K nicht an, in 4K schon.
KIE_RESOLUTION_4X5=4K

# --- Hinter einem Tunnel oder Load Balancer (WP-14) ---------------------------
# Leer = aus. '*' vertraut jedem Weiterleitungskopf und gehoert nur in die
# Entwicklung, etwa hinter ngrok. In Produktion eine Adressliste.
TRUSTED_PROXIES=

# --- Google Calendar (WP-14) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"

# --- Microsoft Graph (WP-15) -------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI="${APP_URL}/oauth/microsoft/callback"

# --- Zugang (WP-04) ----------------------------------------------------------
# false: keine offene Registrierung, das Team kommt ueber Einladungen herein.
REGISTRATION_SELF_SERVICE=false

# --- Agent (WP-22..WP-24) ----------------------------------------------------
ANTHROPIC_API_KEY=
# Nur setzen, wer gegen eine eigene Gegenstelle prueft.
ANTHROPIC_API_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
AGENT_MODEL=claude-sonnet-5
# Not-Aus auf Installationsebene. Ueberstimmt jede Mandanteneinstellung.
AGENT_KILL_SWITCH=false

# --- Betrieb (Entscheidung S9) -----------------------------------------------
# Horizon: /horizon, Pulse: /pulse. Beide sind in Produktion ueber Gates zu
# schuetzen, siehe WP-05.
PULSE_ENABLED=true

# Leer lassen heisst: Sentry meldet nichts. Kein Fehler, nur stumm.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

VITE_APP_NAME="${APP_NAME}"

# Virenpruefung der Anhaenge (WP-33). Ohne Host ist keine angebunden -- dann
# wird jeder Anhang als 'unscanned' vermerkt und nicht ausgeliefert.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=10

# Abo und Abrechnung (WP-06, Entscheidung B9). Ohne Schluessel ist die
# Abrechnung nicht eingerichtet -- die Praxis bleibt in der Testphase.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Preise netto (docs/produkt.md, Preismodell): Abo 790 EUR/Monat, Aufstockung
# 59 EUR je Block, Bild 2 EUR, Einrichtung 1.490 EUR einmalig. Leer bei
# STRIPE_SETUP_PRICE_ID heisst: keine Einrichtungsgebuehr.
STRIPE_PRICE_ID=
STRIPE_TOPUP_PRICE_ID=
STRIPE_IMAGE_PRICE_ID=
STRIPE_SETUP_PRICE_ID=

# Antworten im offenen WhatsApp-Service-Fenster (Entscheidung B14), in Cent je
# Antwort. 0 = gezaehlt, aber nicht berechnet. Ein Wert ueber 0 geht ab dann
# als Sammelposten auf die naechste Rechnung; gesperrt wird eine Antwort nie.
WHATSAPP_SERVICEFENSTER_CENT=0
