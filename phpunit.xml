<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!-- Laeuft ohne RefreshDatabase: die Nebenlaeufigkeitstests brauchen
             echte Transaktionen auf zwei Verbindungen, und eine umschliessende
             Testtransaktion macht die zweite Verbindung blind fuer alles, was
             die erste noch nicht festgeschrieben hat. -->
        <testsuite name="Parallel">
            <directory>tests/Parallel</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>

        <!-- Bewusst MySQL statt SQLite im Speicher: die Verfuegbarkeits-Engine
             (WP-10) und die Warteliste (WP-25) verlassen sich auf Sperrverhalten,
             generierte Spalten und JSON-Abfragen, die SQLite anders oder gar
             nicht abbildet. Ein gruener Test auf SQLite waere hier wertlos. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="mysql"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="mrs_beauty_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value="root"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <!-- Kein Zugriff auf echte Drittsysteme aus Tests heraus. -->
        <env name="META_API_VERSION" value="v21.0"/>
        <env name="ANTHROPIC_API_KEY" value="test-key-not-used"/>
        <env name="AGENT_KILL_SWITCH" value="false"/>
    </php>
</phpunit>
